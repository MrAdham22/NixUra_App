<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg_round" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/w_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Drink water"
            android:textColor="#FFF6EFEE"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="3 / 8"
                android:textColor="#FFF6EFEE"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_minus"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_btn_minus"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="−"
                android:textColor="#FFF6EFEE"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_plus"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/widget_btn_plus"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="+"
                android:textColor="#FF1D1A39"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/w_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:progress="400"
            android:progressDrawable="@drawable/widget_progress" />

        <TextView
            android:id="@+id/w_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="5 to go"
            android:textColor="#FFD6CCD6"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
