<?xml version="1.0" encoding="utf-8"?>
<!-- GENERATED by the widget layout generator; see docs. Card look mirrors the in-app cards. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_card_22" android:scaleType="fitXY" />

    <ImageView
        android:id="@+id/w_border"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_card_22_border" android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/w_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">
<FrameLayout
        android:id="@+id/w_badge"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="12dp">
<ImageView
        android:id="@+id/w_badge_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_badge_bg" android:scaleType="fitXY" />
<ImageView
        android:id="@+id/w_badge_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_w_flame" />
    </FrameLayout>
<LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1">
<TextView
        android:id="@+id/w_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:text=""
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium" />
<TextView
        android:id="@+id/w_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:text=""
        android:textColor="#FFFFFFFF"
        android:textSize="12sp" />
<FrameLayout
        android:id="@+id/w_prog"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp">
<ImageView
        android:id="@+id/w_prog_track"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_pill" android:scaleType="fitXY" />
<ImageView
        android:id="@+id/w_prog_fill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_pill_clip" android:scaleType="fitXY" />
    </FrameLayout>
    </LinearLayout>
<FrameLayout
        android:id="@+id/w_minus"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="8dp"
        android:clickable="true"
        android:focusable="true">
<ImageView
        android:id="@+id/w_minus_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_circle" android:scaleType="fitXY" />
<ImageView
        android:id="@+id/w_minus_bd"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_circle_border" android:scaleType="fitXY" />
<ImageView
        android:id="@+id/w_minus_icon"
        android:layout_width="17dp"
        android:layout_height="17dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_w_minus" />
    </FrameLayout>
<FrameLayout
        android:id="@+id/w_plus"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:clickable="true"
        android:focusable="true">
<ImageView
        android:id="@+id/w_plus_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_circle" android:scaleType="fitXY" />
<ImageView
        android:id="@+id/w_plus_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_w_plus" />
    </FrameLayout>
    </LinearLayout>
</FrameLayout>
