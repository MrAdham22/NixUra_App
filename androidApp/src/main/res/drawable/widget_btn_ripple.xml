<?xml version="1.0" encoding="utf-8"?>
<!-- Pressed feedback of the widget +/- buttons. The launcher draws it on touch-down, before NixUra's process runs,
     so every tap is acknowledged at once (phase A1). White at 33%: visible on the dark, light and prayer cards. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#55FFFFFF">
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
