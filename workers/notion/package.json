{
  "name": "nixura-notion-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply nixura-notion --local",
    "db:migrate:remote": "wrangler d1 migrations apply nixura-notion --remote"
  },
  "dependencies": {
    "jose": "5.9.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "wrangler": "4.150.0"
  }
}
