// NixUra Notion link: replaces the Notion part of the old Node /backend.
// Secrets (never in this file or in git), set with `npx wrangler secret put <NAME>`:
//   NOTION_CLIENT_ID, NOTION_CLIENT_SECRET  (from the Notion public integration)
//   INTEGRATION_TOKEN_KEY                   (32 random bytes, base64; encrypts the Notion tokens at rest)
//   GEMINI_API_KEY, GROQ_API_KEY, MISTRAL_API_KEY, OPENROUTER_API_KEY  (AI coach; each is optional)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nixura-notion",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "FIREBASE_PROJECT_ID": "nixura",
    "APP_RETURN_URL": "nixura://integrations/notion",
    // AI coach. Order of the free AI services; one without its key is skipped. Change and redeploy to reorder.
    "AI_CHAIN": "gemini,groq,cloudflare,mistral,openrouter",
    // Per signed-in user, per UTC day.
    "AI_CHAT_PER_DAY": "10",
    "AI_VOICE_PER_DAY": "2",
    "GEMINI_MODEL": "gemini-flash-lite-latest",
    "GROQ_MODEL": "openai/gpt-oss-120b",
    "GROQ_WHISPER_MODEL": "whisper-large-v3-turbo",
    "CF_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "CF_WHISPER_MODEL": "@cf/openai/whisper-large-v3-turbo",
    "MISTRAL_MODEL": "mistral-small-latest",
    "OPENROUTER_MODEL": "openrouter/free"
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nixura-notion",
      "database_id": "3ff987ee-e71f-47d5-9dbb-858f8d84ff18",
      "migrations_dir": "migrations"
    }
  ],
  // Per user (or per IP for the public callback), counted at each Cloudflare location.
  "ratelimits": [
    { "name": "NOTION_LIMIT", "namespace_id": "4101", "simple": { "limit": 60, "period": 60 } },
    { "name": "START_LIMIT", "namespace_id": "4102", "simple": { "limit": 10, "period": 60 } },
    { "name": "CALLBACK_LIMIT", "namespace_id": "4103", "simple": { "limit": 30, "period": 60 } },
    { "name": "AI_LIMIT", "namespace_id": "4104", "simple": { "limit": 12, "period": 60 } }
  ]
}
