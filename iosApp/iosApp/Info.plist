<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- NixUra server (https only): the Notion Worker in workers/notion. -->
	<key>NixUraApiBaseUrl</key>
	<string>https://nixura-notion.nixura-notion-worker.workers.dev</string>
	<!-- The languages the app speaks, so iOS offers Settings → NixUra → Language (English / العربية). -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ar</string>
	</array>
</dict>
</plist>