<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- NixUra server (https only): the Notion Worker in workers/notion. -->
	<key>NixUraApiBaseUrl</key>
	<string>https://nixura-notion.nixura-notion-worker.workers.dev</string>
	<!-- The languages the app speaks, so iOS offers Settings → NixUra → Language (English / العربية). -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ar</string>
	</array>
	<!-- The bug-report screen opens the Mail app with a mailto: link; canOpenURL needs the scheme listed. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>mailto</string>
	</array>
	<!-- Home-screen quick actions (long-press the icon), the iOS twin of Android's res/xml/shortcuts.xml.
	     The type suffix is the shared AppShortcut id; iOSApp.swift hands it to IosShortcuts.handle. -->
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.adhamelgendy.nixura.keep_nixura</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>🥺 Don't delete NixUra!</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>heart.fill</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.adhamelgendy.nixura.report_bug</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>🐛 Bugs or issues?</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>ladybug.fill</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.adhamelgendy.nixura.help</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>💡 Need help?</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>questionmark.circle.fill</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>com.adhamelgendy.nixura.ai_coach</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>🧠 Talk to your AI Coach</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>sparkles</string>
		</dict>
	</array>
</dict>
</plist>