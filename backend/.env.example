# Copy to .env (never commit .env). All secrets come from the environment.
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
DATABASE_URL=postgres://nixura:nixura@localhost:5432/nixura

# >= 32 random bytes each. Generate: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
OTP_PEPPER=change-me-change-me-change-me-change-me

# Email: "console" prints codes to the server log (dev only), "resend" sends real mail.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=NixUra <no-reply@example.com>

# Comma-separated allowed browser origins (the mobile app does not need CORS). Empty = none.
CORS_ORIGINS=

# Set to the number of reverse proxies in front of the server so client IPs are correct (0 = none).
TRUST_PROXY_HOPS=0

# Argon2id tuning (memory in KiB). Defaults follow OWASP's minimum recommendation.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Optional breached-password check via the Pwned Passwords k-anonymity API (true/false).
HIBP_CHECK=false
